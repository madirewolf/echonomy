# Copy this file to .env and fill in what you have. The app's demo mode works with nothing set.

# From https://developer.spotify.com/dashboard — create an app, add redirect URI http://127.0.0.1:5173/callback
SPOTIFY_CLIENT_ID=

# From https://genius.com/api-clients — create an API client, generate a client access token
GENIUS_ACCESS_TOKEN=

PORT=5173
